PORT=5000
DATABASE_URL=mysql://root:password@localhost:3306/portfolio
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=portfolio
DB_SSL=false # set to true for cloud MySQL providers (Aiven, PlanetScale, Railway, AWS RDS)

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false # Set to true in production HTTPS environments

ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=admin_secure_password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:5173
NODE_ENV=development
